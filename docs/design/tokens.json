{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.example.com/design-tokens.json",
  "title": "Cadence Design Tokens",
  "description": "Complete design token specification for Cadence. Source of truth for all visual tokens. Generated from design_tokens.rs — do not edit directly.",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "light": {
      "$ref": "#/definitions/DesignTokens"
    },
    "dark": {
      "$ref": "#/definitions/DesignTokens"
    }
  },
  "required": ["light", "dark"],
  "definitions": {
    "DesignTokens": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/definitions/ColorSystem" },
        "typography": { "$ref": "#/definitions/TypographyScale" },
        "spacing": { "$ref": "#/definitions/SpacingSystem" },
        "radius": { "$ref": "#/definitions/RadiusSystem" },
        "elevation": { "$ref": "#/definitions/ElevationSystem" },
        "motion": { "$ref": "#/definitions/MotionSystem" },
        "density": { "$ref": "#/definitions/DensitySystem" }
      },
      "required": ["color", "typography", "spacing", "radius", "elevation", "motion", "density"]
    },
    "ColorSystem": {
      "type": "object",
      "properties": {
        "surface": { "$ref": "#/definitions/SurfaceColors" },
        "text": { "$ref": "#/definitions/TextColors" },
        "accent": { "$ref": "#/definitions/AccentColors" },
        "border": { "$ref": "#/definitions/BorderColors" },
        "focus": { "$ref": "#/definitions/FocusColors" },
        "status": { "$ref": "#/definitions/StatusColors" },
        "overlay": { "$ref": "#/definitions/OverlayColors" }
      },
      "required": ["surface", "text", "accent", "border", "focus", "status", "overlay"]
    },
    "SurfaceColors": {
      "type": "object",
      "properties": {
        "base": { "type": "string", "format": "color-hex", "description": "Window background behind panels" },
        "raised": { "type": "string", "format": "color-hex", "description": "Panel, grid, and popup surface" },
        "sunken": { "type": "string", "format": "color-hex", "description": "Sunken/inset surfaces (e.g., Gantt canvas)" },
        "hover": { "type": "string", "format": "color-hex", "description": "Subtle background for hover states" },
        "active": { "type": "string", "format": "color-hex", "description": "Active/pressed background" },
        "disabled": { "type": "string", "format": "color-hex", "description": "Disabled surface" }
      },
      "required": ["base", "raised", "sunken", "hover", "active", "disabled"]
    },
    "TextColors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string", "format": "color-hex", "description": "Primary body text" },
        "secondary": { "type": "string", "format": "color-hex", "description": "Secondary text: units, hints" },
        "muted": { "type": "string", "format": "color-hex", "description": "Muted/placeholder text" },
        "disabled": { "type": "string", "format": "color-hex", "description": "Disabled text" },
        "on_accent": { "type": "string", "format": "color-hex", "description": "Text on accent fills" },
        "on_critical": { "type": "string", "format": "color-hex", "description": "Text on critical backgrounds" },
        "on_warning": { "type": "string", "format": "color-hex", "description": "Text on warning backgrounds" },
        "on_success": { "type": "string", "format": "color-hex", "description": "Text on success backgrounds" }
      },
      "required": ["primary", "secondary", "muted", "disabled", "on_accent", "on_critical", "on_warning", "on_success"]
    },
    "AccentColors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string", "format": "color-hex", "description": "Primary accent — selection, links, focus ring" },
        "hover": { "type": "string", "format": "color-hex", "description": "Hover state for accent" },
        "active": { "type": "string", "format": "color-hex", "description": "Active/pressed state for accent" },
        "subtle": { "type": "string", "format": "color-rgba", "description": "Subtle accent tint for selected tabs (20% opacity)" },
        "primary_bg": { "type": "string", "format": "color-rgba", "description": "Accent background for primary buttons (15% opacity)" }
      },
      "required": ["primary", "hover", "active", "subtle", "primary_bg"]
    },
    "BorderColors": {
      "type": "object",
      "properties": {
        "subtle": { "type": "string", "format": "color-hex", "description": "Hairlines, table grid lines, Gantt grid" },
        "strong": { "type": "string", "format": "color-hex", "description": "Strong borders: input outlines, focused fields" },
        "accent": { "type": "string", "format": "color-hex", "description": "Accent border for selected state" },
        "critical": { "type": "string", "format": "color-hex", "description": "Critical/error border" },
        "warning": { "type": "string", "format": "color-hex", "description": "Warning border" }
      },
      "required": ["subtle", "strong", "accent", "critical", "warning"]
    },
    "FocusColors": {
      "type": "object",
      "properties": {
        "ring": { "type": "string", "format": "color-hex", "description": "Visible keyboard focus ring stroke (≥3:1 against surface)" },
        "offset": { "type": "string", "format": "color-hex", "description": "Focus ring offset colour (usually surface base)" }
      },
      "required": ["ring", "offset"]
    },
    "StatusColors": {
      "type": "object",
      "properties": {
        "critical": { "type": "string", "format": "color-hex", "description": "Critical activities, failures, delays" },
        "normal": { "type": "string", "format": "color-hex", "description": "Non-critical activities, normal state" },
        "success": { "type": "string", "format": "color-hex", "description": "Passes, on-track, improvements" },
        "warning": { "type": "string", "format": "color-hex", "description": "Warnings, near-critical" },
        "variance_positive": { "type": "string", "format": "color-hex", "description": "Variance positive (delay/overspend) — red family" },
        "variance_negative": { "type": "string", "format": "color-hex", "description": "Variance negative (improvement/underspend) — green family" },
        "non_working": { "type": "string", "format": "color-hex", "description": "Non-working day background tint (weekends/holidays)" },
        "status_date": { "type": "string", "format": "color-rgba", "description": "Status date line (dotted indicator)" }
      },
      "required": ["critical", "normal", "success", "warning", "variance_positive", "variance_negative", "non_working", "status_date"]
    },
    "OverlayColors": {
      "type": "object",
      "properties": {
        "scrim": { "type": "string", "format": "color-rgba", "description": "Modal backdrop dimming" },
        "popover": { "type": "string", "format": "color-hex", "description": "Popover/dropdown background" },
        "tooltip": { "type": "string", "format": "color-hex", "description": "Tooltip background" }
      },
      "required": ["scrim", "popover", "tooltip"]
    },
    "TypographyScale": {
      "type": "object",
      "properties": {
        "display": { "$ref": "#/definitions/FontSpec" },
        "h1": { "$ref": "#/definitions/FontSpec" },
        "h2": { "$ref": "#/definitions/FontSpec" },
        "h3": { "$ref": "#/definitions/FontSpec" },
        "body": { "$ref": "#/definitions/FontSpec" },
        "small": { "$ref": "#/definitions/FontSpec" },
        "caption": { "$ref": "#/definitions/FontSpec" },
        "mono": { "$ref": "#/definitions/FontSpec" },
        "button": { "$ref": "#/definitions/FontSpec" }
      },
      "required": ["display", "h1", "h2", "h3", "body", "small", "caption", "mono", "button"]
    },
    "FontSpec": {
      "type": "object",
      "properties": {
        "size": { "type": "number", "description": "Font size in logical points (1pt = 1/72in)" },
        "weight": { "type": "string", "enum": ["normal", "medium", "semibold", "bold"], "description": "Font weight name" },
        "line_height": { "type": "number", "description": "Line height as multiplier of font size" },
        "letter_spacing": { "type": ["number", "null"], "description": "Letter spacing in px" }
      },
      "required": ["size", "weight", "line_height"]
    },
    "SpacingSystem": {
      "type": "object",
      "properties": {
        "base": { "type": "number", "const": 4, "description": "Base unit in px (always 4)" },
        "tokens": {
          "type": "object",
          "patternProperties": {
            "^(xs|sm|md|lg|xl|2xl|3xl|4xl|5xl)$": { "type": "number" }
          },
          "additionalProperties": false,
          "description": "Named spacing tokens (multipliers: 0.5, 1, 2, 3, 4, 6, 8, 12, 16)"
        },
        "component": { "$ref": "#/definitions/ComponentSpacing" }
      },
      "required": ["base", "tokens", "component"]
    },
    "ComponentSpacing": {
      "type": "object",
      "properties": {
        "item_spacing_x": { "type": "number", "description": "Horizontal item spacing (8px)" },
        "item_spacing_y": { "type": "number", "description": "Vertical item spacing (4px)" },
        "button_padding_x": { "type": "number", "description": "Button horizontal padding (8px)" },
        "button_padding_y": { "type": "number", "description": "Button vertical padding (4px)" },
        "menu_margin_x": { "type": "number", "description": "Menu horizontal margin (8px)" },
        "menu_margin_y": { "type": "number", "description": "Menu vertical margin (4px)" },
        "panel_margin": { "type": "number", "description": "Panel margin (12px)" },
        "indent": { "type": "number", "description": "Indent (16px)" },
        "grid_spacing_x": { "type": "number", "description": "Grid horizontal spacing (48px)" },
        "grid_spacing_y": { "type": "number", "description": "Grid vertical spacing (16px)" }
      },
      "required": ["item_spacing_x", "item_spacing_y", "button_padding_x", "button_padding_y", "menu_margin_x", "menu_margin_y", "panel_margin", "indent", "grid_spacing_x", "grid_spacing_y"]
    },
    "RadiusSystem": {
      "type": "object",
      "properties": {
        "none": { "type": "number", "const": 0, "description": "No radius" },
        "sm": { "type": "number", "const": 2, "description": "Small radius (2px) — badges, chips" },
        "md": { "type": "number", "const": 4, "description": "Medium radius (4px) — interactive widgets" },
        "lg": { "type": "number", "const": 6, "description": "Large radius (6px) — windows, menus, panels" },
        "xl": { "type": "number", "const": 8, "description": "Extra large radius (8px) — cards, modals" },
        "full": { "type": "number", "const": 9999, "description": "Full radius (9999px) — pills, avatars" }
      },
      "required": ["none", "sm", "md", "lg", "xl", "full"]
    },
    "ElevationSystem": {
      "type": "object",
      "properties": {
        "level0": { "$ref": "#/definitions/ShadowSpec" },
        "level1": { "$ref": "#/definitions/ShadowSpec" },
        "level2": { "$ref": "#/definitions/ShadowSpec" },
        "level3": { "$ref": "#/definitions/ShadowSpec" }
      },
      "required": ["level0", "level1", "level2", "level3"]
    },
    "ShadowSpec": {
      "type": "object",
      "properties": {
        "offset_x": { "type": "number", "description": "Horizontal offset" },
        "offset_y": { "type": "number", "description": "Vertical offset" },
        "blur": { "type": "number", "description": "Blur radius" },
        "spread": { "type": "number", "description": "Spread radius" },
        "color": { "type": "string", "format": "color-rgba", "description": "Shadow colour with alpha" }
      },
      "required": ["offset_x", "offset_y", "blur", "spread", "color"]
    },
    "MotionSystem": {
      "type": "object",
      "properties": {
        "duration": { "$ref": "#/definitions/MotionDuration" },
        "easing": { "$ref": "#/definitions/MotionEasing" },
        "reduced": { "$ref": "#/definitions/ReducedMotion" }
      },
      "required": ["duration", "easing", "reduced"]
    },
    "MotionDuration": {
      "type": "object",
      "properties": {
        "instant": { "type": "integer", "const": 0, "description": "Instant — 0ms (focus ring, selection)" },
        "fast": { "type": "integer", "const": 100, "description": "Fast — 100ms (hover, tooltip)" },
        "normal": { "type": "integer", "const": 150, "description": "Normal — 150ms (panel expand, sidebar)" },
        "slow": { "type": "integer", "const": 250, "description": "Slow — 250ms (modal, drawer)" }
      },
      "required": ["instant", "fast", "normal", "slow"]
    },
    "MotionEasing": {
      "type": "object",
      "properties": {
        "ease_out": { "type": "string", "const": "cubic-bezier(0.25, 0.46, 0.45, 0.94)", "description": "Standard ease-out for most transitions" },
        "ease_in_out": { "type": "string", "const": "cubic-bezier(0.42, 0.0, 0.58, 1.0)", "description": "Ease-in-out for modal/drawer" },
        "spring": { "type": "string", "const": "cubic-bezier(0.34, 1.56, 0.64, 1.0)", "description": "Spring-like for interactive elements" }
      },
      "required": ["ease_out", "ease_in_out", "spring"]
    },
    "ReducedMotion": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether reduced motion is enabled (set at runtime from OS)" },
        "duration_overrides": {
          "type": "object",
          "patternProperties": {
            "^(instant|fast|normal|slow)$": { "type": "integer", "minimum": 0 }
          },
          "description": "Override durations when reduced motion is active"
        }
      },
      "required": ["enabled", "duration_overrides"]
    },
    "DensitySystem": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["compact", "standard", "comfortable"], "description": "Current density level" },
        "multipliers": { "$ref": "#/definitions/DensityMultipliers" }
      },
      "required": ["level", "multipliers"]
    },
    "DensityMultipliers": {
      "type": "object",
      "properties": {
        "compact": { "type": "number", "const": 0.875, "description": "Compact density multiplier" },
        "standard": { "type": "number", "const": 1.0, "description": "Standard density multiplier" },
        "comfortable": { "type": "number", "const": 1.125, "description": "Comfortable density multiplier" }
      },
      "required": ["compact", "standard", "comfortable"]
    }
  }
}